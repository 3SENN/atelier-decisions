+//   ATELIER_DECISION_MODEL_SRC=<folder> node scripts/fetch-decision-model.mjs
+//
+// The folder is a student export of the atelier-decisions project (student/export.py): the model file,
+// the trimmed tokenizer, the vocabulary map and the calibration. Nothing is downloaded: the model is built
+// and checked there (Atelier's own decision eval, parity of this runtime with the training code), and copied
+// here as it is. Exits non-zero without a source, so `npm run package` ships without it and says so.
+import { copyFileSync, existsSync, mkdirSync, statSync } from 'node:fs'
+import { dirname, join } from 'node:path'
+import { fileURLToPath } from 'node:url'
+
+const FILES = ['model.emb4.int8.onnx', 'tokenizer.json', 'tokenizer_config.json', 'vocab.json']
+const OPTIONAL = ['calibration.json']
+const repo = join(dirname(fileURLToPath(import.meta.url)), '..')
+const out = join(repo, 'native', 'decisions', 'build')
+const source = process.env.ATELIER_DECISION_MODEL_SRC
+
+if (!source || !existsSync(source)) {
+  console.error('Set ATELIER_DECISION_MODEL_SRC to an exported decision model folder.')
+  process.exit(1)
+}
+const missing = FILES.filter((f) => !existsSync(join(source, f)))
+if (missing.length) {
+  console.error(`${source} has no ${missing.join(', ')}`)
+  process.exit(1)
+}
+mkdirSync(out, { recursive: true })
+let bytes = 0
+for (const f of [...FILES, ...OPTIONAL.filter((f) => existsSync(join(source, f)))]) {
+  copyFileSync(join(source, f), join(out, f))
+  bytes += statSync(join(out, f)).size
+}
+console.log(`On-device decision model: ${(bytes / 1e6).toFixed(1)} MB in ${out}`)
