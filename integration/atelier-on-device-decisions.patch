+                {t('decisions.device.mini.cancel')}
+              </Button>
+            )}
+            {mini.state === 'ready' && !mini.external && (
+              <Button size="sm" variant="ghost" onClick={() => onMini('remove')}>
+                {t('decisions.device.mini.remove')}
+              </Button>
+            )}
+          </div>
+        </div>
+      )}
+    </div>
+  )
