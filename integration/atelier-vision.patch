+    expect(tool.parse.safeParse({ pictures: Array.from({ length: LABEL_PICTURES_MAX + 1 }, () => ({})), questions: { album } }).success).toBe(false)
+    expect(tool.parse.safeParse({ pictures: [{}], questions: {} }).success).toBe(false)
