# Auto detect text files and perform LF normalization
* text=auto
# Saved versions are hashed in MANIFEST.json: check them out byte for byte, never with converted line endings
releases/** -text
releases/**/*.zip filter=lfs diff=lfs merge=lfs -text
releases/**/*.patch filter=lfs diff=lfs merge=lfs -text
releases/**/*.onnx filter=lfs diff=lfs merge=lfs -text
releases/**/*.pt filter=lfs diff=lfs merge=lfs -text
